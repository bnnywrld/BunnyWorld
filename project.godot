config_version=5

[application]
config/name="Bunny World 0.2.0.6"
config/version="0.2.0.6"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="BunnyWorld"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.0196, 0.0392, 0.0706, 1)

[gui]
theme/default_font_multichannel_signed_distance_field=true

[audio]
driver/enable_input=false
